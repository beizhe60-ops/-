APP_NAME="Telegram Ops Workbench"
APP_SECRET_KEY="replace-with-a-long-random-secret-at-least-32-chars"
ENCRYPTION_KEY=""
DATABASE_URL="sqlite:///./telegram_ops.db"
AUTO_START_TELEGRAM_WORKERS=true
CONFIG_RELOAD_SECONDS=10
HEALTH_CHECK_SECONDS=60
QUEUE_POLL_SECONDS=3
DEFAULT_ACCOUNT_DAILY_LIMIT=80
DEFAULT_USER_DAILY_LIMIT=3
DEFAULT_USER_COOLDOWN_SECONDS=86400

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123456"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false
ADMIN_ALLOWED_IPS=""

